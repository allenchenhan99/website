{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "allenlin-content-admin",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-03",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "ADMIN_EMAIL": "allenchenhan99@gmail.com",
    "GITHUB_OWNER": "allenchenhan99",
    "GITHUB_REPO": "website",
    "GITHUB_BRANCH": "main"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
