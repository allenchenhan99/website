---
import { Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { recentPosts } from "../lib/content";
import backgroundImage from "../assets/images/IMG_1049.JPG";
import profileImage from "../assets/images/selfie.JPG";
import asciiArt from "../../asciiArt.txt?raw";
import chipi from "../../chipi.txt?raw";
import chipiUrl from "../../chipi.txt?url";
import "../styles/style.css";
import "../styles/responsive.css";

const initialChipiFrame = chipi.trimEnd().split("\n").slice(0, 42).join("\n");
const reachStatsUrl = import.meta.env.PUBLIC_REACH_STATS_URL?.trim();
---

<BaseLayout activePage="index">
  <div class="content">
    <pre class="ascii-art" id="ascii-art" data-ascii-animation aria-label="Allen Lin ASCII art"></pre>
    <template data-ascii-source>{asciiArt}</template>

    <pre
      class="chipi-animation"
      id="chipi-animation"
      data-chipi-src={chipiUrl}
      aria-label="Chipi ASCII animation"
    >{initialChipiFrame}</pre>

    <section class="home-profile" aria-labelledby="profile-heading">
      <figure class="home-profile-visual">
        <div class="home-profile-backdrop">
          <Picture
            src={backgroundImage}
            formats={['avif', 'webp']}
            widths={[320, 640, 960, 1280]}
            sizes="(max-width: 768px) calc(100vw - 32px), min(50vw, 544px)"
            alt="Background Photo"
            loading="lazy"
          />
        </div>
        <div class="home-profile-avatar">
          <Picture
            src={profileImage}
            formats={['avif', 'webp']}
            widths={[126, 160, 320]}
            sizes="(max-width: 768px) 126px, 160px"
            alt="Profile Photo"
            loading="lazy"
          />
        </div>
        <figcaption>ALLEN LIN · PROFILE / 2026</figcaption>
      </figure>

      <div class="home-profile-copy">
        <h1 id="profile-heading">Welcome to my Profile</h1>
        <p>
          Hi there! I'm someone with a deep curiosity and passion for just about everything, especially technology, music, and more. This space is my little corner to document and share my journey, personal and spiritual growth, and thoughts.
          The reason I created this site is that, compared to mainstream social media, those platforms often feel like they're all about following trends or being told how to express yourself. I wanted a space where I could freely share my ideas and experiences without those limitations.
          Feel free to explore and learn more about who I am and what I do!
        </p>
      </div>
    </section>

    {recentPosts.length > 0 && (
      <section class="recent-posts" aria-labelledby="recent-heading">
        <header class="recent-header">
          <h2 class="section-title" id="recent-heading">Recent</h2>
          <span>Latest notes from the site</span>
        </header>
        <div class="recent-list">
          {recentPosts.map((post) => {
            const title = post.category === "music" ? post.title : `${post.brand} — ${post.name}`;
            const href = `${post.category}.html`;

            return (
              <button
                class="recent-item"
                type="button"
                data-recent-open
                data-detail-href={href}
                aria-haspopup="dialog"
              >
                <span class="recent-source">
                  <span class:list={["recent-tag", post.category]}>{post.category}</span>
                  <span class="recent-date">{post.date}</span>
                </span>
                <span class="recent-title">{title}</span>
                <span class="recent-excerpt">{post.excerpt}</span>
              </button>
            );
          })}
        </div>
      </section>
    )}

    <section
      class="reach-signal"
      aria-labelledby="reach-signal-heading"
      data-reach-stats-url={reachStatsUrl || undefined}
    >
      <header class="reach-signal-intro">
        <div>
          <h2 id="reach-signal-heading">Site reach signal</h2>
          <p>A public trace of how far this small corner has travelled.</p>
        </div>
        <span data-reach-source>sample data · 30 days</span>
      </header>
      <figure class="reach-signal-surface" data-reach-surface>
        <pre class="reach-flow" data-reach-flow aria-hidden="true"></pre>
        <div class="reach-ticker" data-reach-ticker aria-label="Reach market summary">RCH 1,284&nbsp; ▲18.0% &nbsp;│&nbsp; PVW 3,912 &nbsp;│&nbsp; 30D H 97 / L 18</div>
        <figcaption class="reach-signal-status">
          <span>30D AGO</span>
          <span>character density = daily reach</span>
          <span>TODAY</span>
        </figcaption>
      </figure>
    </section>
  </div>

  <dialog
    class="detail-overlay"
    data-detail-dialog
    aria-labelledby="detail-title"
  >
    <div class="detail-modal">
      <div class="detail-body">
        <div class="detail-meta">
          <span class="recent-tag" data-detail-category></span>
          <span class="recent-date" data-detail-date></span>
        </div>
        <h2 class="detail-title" id="detail-title" data-detail-title></h2>
        <p class="detail-text" data-detail-excerpt></p>
      </div>
      <div class="detail-footer">
        <a href="#" class="detail-link" data-detail-link>Go to category page</a>
        <button class="detail-close" type="button" data-detail-close>Close</button>
      </div>
    </div>
  </dialog>

  <script>
    import { initializeHome } from "../scripts/home";

    initializeHome();
  </script>
</BaseLayout>
