---
import { Image, Picture } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { musicPosts } from "../lib/content";
import { resolveCoverUrl } from "../scripts/music";
import heroImage from "../assets/images/pxfuel.jpg";
import vinylImage from "../assets/images/vinyl-record-ochre.png";
import westernHipHopCover from "../assets/images/spotify-western-hiphop.jpg";
import koreanHipHopCover from "../assets/images/spotify-korean-hiphop.jpg";
import "../styles/music.css";
import "../styles/responsive.css";

const playlists = [
  {
    title: "Western Hip-Hop",
    href: "https://open.spotify.com/playlist/0zOH4tLo3gS91K392iVukK?utm_source=generator",
    cover: westernHipHopCover,
  },
  {
    title: "Korean Hip-Hop",
    href: "https://open.spotify.com/playlist/5FEkaCPvkQamrTWBAIvSra?utm_source=generator",
    cover: koreanHipHopCover,
  },
] as const;
---

<BaseLayout pageTitle="Music" activePage="music">
  <section class="hero" aria-labelledby="music-heading">
    <div class="image-container">
      <Picture
        src={heroImage}
        formats={['avif', 'webp']}
        widths={[640, 960, 1280, 1920]}
        sizes="100vw"
        alt="Nujabes Metaphorical Music album artwork"
        priority
      />
      <div
        class="vinyl-record"
        data-vinyl="album-art"
        role="img"
        aria-label="Rotating vinyl record filled with Nujabes Metaphorical Music cover art"
      >
        <Image
          class="vinyl-base"
          src={vinylImage}
          widths={[100, 200, 400]}
          sizes="(max-width: 768px) 105px, 200px"
          alt=""
        />
        <span class="vinyl-material" aria-hidden="true">
          <Image
            class="vinyl-artwork"
            src={heroImage}
            widths={[100, 200, 400]}
            sizes="(max-width: 768px) 90px, 174px"
            alt=""
          />
        </span>
        <span class="vinyl-label" aria-hidden="true">
          <span class="vinyl-spindle"></span>
        </span>
      </div>
      <aside class="hero-playlists" aria-labelledby="playlists-heading">
        <header class="hero-playlists-header">
          <h2 id="playlists-heading">Playlists</h2>
          <span>02 / Spotify</span>
        </header>
        <nav aria-label="Allen's Spotify playlists">
          {playlists.map((playlist, index) => (
            <a
              class="hero-playlist-link"
              href={playlist.href}
              target="_blank"
              rel="noreferrer"
            >
              <Image
                class="hero-playlist-cover"
                src={playlist.cover}
                widths={[48, 96]}
                sizes="48px"
                alt={`${playlist.title} playlist cover`}
              />
              <span class="hero-playlist-copy">
                <small>{String(index + 1).padStart(2, "0")} / Playlist</small>
                <strong>{playlist.title}</strong>
              </span>
              <span class="hero-playlist-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </nav>
      </aside>
      <div class="text-container">
        <h1 id="music-heading">Welcome to the Music Page</h1>
        <p>
          Here, you can delve into the finer nuances of albums and songs—details that might often escape your notice—along with my personal reflections.
          Among the senses, apart from sight, perhaps only music can truly engage in a harmonious multitasking relationship with you over an extended period.
          It transcends boundaries, defies cultural or linguistic barriers, and through carefully orchestrated melodies and emotive expressions,
          allows you to immerse yourself in the emotions of the moment of creation, while simultaneously evoking profound sentiments and forging unforgettable memories.
          Let the rhythm guide you on a melodic odyssey.
        </p>
        <p><br /></p>
        <p>
          The image above showcases an album cover reminiscent of the "Metaphorical" style by one of my favorite producers, DJs, and composers, "Nujabes".
          His music possesses an extraordinary ability to anchor and soothe me during moments of emotional turbulence.
          In contrast to the atmospheric intensity of modern trap music, the jazz hip-hop vibe he creates casts a more immersive and tranquilizing ambiance,
          enveloping the surrounding environment and drawing listeners into a state of mindful resonance.
        </p>
      </div>
    </div>
  </section>

  <section class="posts-section" data-music-view data-view="grid" aria-labelledby="posts-heading">
    <div class="posts-header">
      <h2 class="posts-title" id="posts-heading">Posts</h2>
      <div class="view-toggle" aria-label="Post view">
        <button class="active" type="button" data-view-mode="grid" aria-label="Grid view" aria-pressed="true">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <rect x="1" y="1" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.5" />
            <rect x="11" y="1" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.5" />
            <rect x="1" y="11" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.5" />
            <rect x="11" y="11" width="6" height="6" rx="1" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </button>
        <button type="button" data-view-mode="list" aria-label="List view" aria-pressed="false">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
            <rect x="1" y="2" width="16" height="3" rx="1" stroke="currentColor" stroke-width="1.5" />
            <rect x="1" y="8" width="16" height="3" rx="1" stroke="currentColor" stroke-width="1.5" />
            <rect x="1" y="14" width="16" height="3" rx="1" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </button>
      </div>
    </div>

    <div class="posts-grid" data-view-panel="grid">
      {musicPosts.map((post) => (
        <article class="grid-card">
          <button class="post-open" type="button" data-post-open data-post-id={String(post.id)} aria-label={`Open ${post.title}`}>
            <span class="grid-cover">
              {post.cover ? (
                <img class="post-cover-image" src={resolveCoverUrl(post.cover)} alt="" loading="lazy" width="640" height="640" />
              ) : <span>No Cover</span>}
            </span>
            <span class="grid-body">
              <span class="grid-meta">
                <span class="tag">{post.tag}</span>
                <span class="post-date">{post.date}</span>
              </span>
              <span class="post-title">{post.title}</span>
              <span class="post-excerpt">{post.excerpt}</span>
            </span>
          </button>
        </article>
      ))}
    </div>

    <div class="posts-list" data-view-panel="list" hidden>
      {musicPosts.map((post) => (
        <article class="list-post">
          <button class="post-open list-open" type="button" data-post-open data-post-id={String(post.id)} aria-label={`Open ${post.title}`}>
            <span class="list-cover">
              {post.cover ? (
                <img class="post-cover-image" src={resolveCoverUrl(post.cover)} alt="" loading="lazy" width="640" height="640" />
              ) : <span>No Cover</span>}
            </span>
            <span class="list-body">
              <span class="list-meta">
                <span class="tag">{post.tag}</span>
                <span class="post-date">{post.date}</span>
              </span>
              <span class="post-title">{post.title}</span>
              <span class="post-excerpt">{post.excerpt}</span>
            </span>
          </button>
        </article>
      ))}
    </div>
  </section>

  <div hidden data-post-details>
    {musicPosts.map((post) => (
      <article data-post-detail data-post-id={String(post.id)} data-cover-url={resolveCoverUrl(post.cover)}>
        <span data-source-tag>{post.tag}</span>
        <span data-source-date>{post.date}</span>
        <span data-source-title>{post.title}</span>
        <span data-source-excerpt>{post.excerpt}</span>
      </article>
    ))}
  </div>

  <dialog class="detail-overlay" data-music-dialog aria-labelledby="music-detail-title">
    <div class="detail-modal">
      <img class="detail-cover" data-dialog-cover alt="" hidden />
      <div class="detail-cover detail-cover-empty" data-dialog-cover-empty></div>
      <div class="detail-body">
        <div class="detail-meta">
          <span class="tag" data-dialog-tag></span>
          <span class="post-date" data-dialog-date></span>
        </div>
        <h2 class="detail-title" id="music-detail-title" data-dialog-title></h2>
        <p class="detail-text" data-dialog-excerpt></p>
      </div>
      <div class="detail-footer">
        <button class="detail-close" type="button" data-dialog-close>Close</button>
      </div>
    </div>
  </dialog>

  <script>
    import { initializeMusic } from "../scripts/music";
    initializeMusic();
  </script>
</BaseLayout>
