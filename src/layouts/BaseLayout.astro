---
import Navigation from "../components/Navigation.astro";
import { SITE, withBase } from "../config/site";

interface Props {
  pageTitle?: string;
  activePage: "index" | "profile" | "cv" | "music" | "perfume";
  documentLanguage?: string;
}

const { pageTitle, activePage, documentLanguage = "zh-Hant" } = Astro.props;
const title = pageTitle ? `${pageTitle} | ${SITE.name}` : SITE.name;
const pageUrl = new URL(Astro.url.pathname, SITE.siteUrl).href;
const imageUrl = new URL(withBase(SITE.ogImage), SITE.siteUrl).href;
---

<!doctype html>
<html lang={documentLanguage}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={SITE.description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={SITE.description} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={SITE.ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={SITE.description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={SITE.ogImageAlt} />
    <link rel="icon" type="image/svg+xml" href={withBase(SITE.faviconSvg)} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase(SITE.faviconPng)} />
    <link rel="apple-touch-icon" href={withBase(SITE.appleTouchIcon)} />
    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      } catch {
        document.documentElement.dataset.theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      }
    </script>
    <slot name="styles" />
  </head>
  <body>
    <Navigation activePage={activePage} />
    <main>
      <slot />
    </main>
  </body>
</html>
