---
interface Props {
  title: string;
  src: string;
}

const { title, src } = Astro.props;
const directUrl = src.replace('/embed/', '/');
---

<section class="spotify-embed" data-spotify-embed data-src={src} style="min-height:352px">
  <p class="spotify-status" data-spotify-status>Spotify playlist loads when this card is nearby.</p>
  <a class="spotify-fallback" data-spotify-fallback href={directUrl} target="_blank" rel="noreferrer">
    Open {title} directly on Spotify
  </a>
</section>
